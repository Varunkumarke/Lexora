# Copy to .env.local and fill in. Never commit real values.

# Optional. When set, the landing-page Contact form POSTs
# { name, email, message } as JSON to this URL and shows "sent" only on a 2xx reply.
# When empty, the form validates input but honestly reports that nothing was sent.
VITE_CONTACT_ENDPOINT=

# Optional. Google OAuth Web Client ID. NOTE: setting it alone does NOT enable
# Google sign-in - the backend must also expose an endpoint that verifies the
# Google ID token and returns the same { token, user } shape as /api/auth/login.
VITE_GOOGLE_CLIENT_ID=860906135153-ru0trem3ecqjjve1gfa11utfml5pj68n.apps.googleusercontent.com
